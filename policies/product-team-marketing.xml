<!--
  Product policy: Team-Marketing
  Applied to APIM Product "team-marketing" which groups every AI API.
  Assign the Marketing security group's subscription to this product.

  Tier: 5,000 TPM / 50 requests-per-minute / 500K tokens-per-day budget (demo-scaled).
-->
<policies>
    <inbound>
        <base />

        <!-- Cross-team guard: the caller's token must belong to THIS team. -->
        <set-variable name="teamMatch" value="@{
            var jwt = context.Request.Headers.GetValueOrDefault("Authorization","").Replace("Bearer ","").AsJwt();
            var groups = jwt?.Claims.GetValueOrDefault("groups","");
            if (groups != null && groups.Contains("{{group-team-marketing}}")) { return "yes"; }
            return "no";
        }" />
        <choose>
            <when condition="@((string)context.Variables["teamMatch"] == "no")">
                <return-response>
                    <set-status code="403" reason="Forbidden" />
                    <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
                    <set-body>{"error":"wrong_team","message":"Your identity is not a member of the team that owns this subscription."}</set-body>
                </return-response>
            </when>
        </choose>

        <!-- SCENARIO 2: Per-minute token cap (Foundry / OpenAI-shaped). -->
        <!-- Counts real prompt+completion tokens so the demo trips quickly; -->
        <!-- distinct header so the team's remaining budget is visible.       -->
        <azure-openai-token-limit
            tokens-per-minute="5000"
            counter-key="@("marketing-tpm")"
            estimate-prompt-tokens="false"
            tokens-consumed-header-name="x-team-tokens-consumed"
            remaining-tokens-header-name="x-team-tokens-remaining" />

        <!-- Request-rate cap for vendor APIs (Anthropic/Bedrock/Vertex). -->
        <rate-limit-by-key calls="50" renewal-period="60"
            counter-key="@("marketing-rpm")"
            remaining-calls-header-name="x-ratelimit-remaining"
            retry-after-header-name="Retry-After" />

        <!-- Daily token budget — resets at midnight UTC. -->
        <quota-by-key calls="500000" renewal-period="86400"
            counter-key="@("marketing-daily")" />
    </inbound>
    <backend><base /></backend>
    <outbound><base /></outbound>
    <on-error><base /></on-error>
</policies>
